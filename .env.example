# ================================================
# Ronviana Admin Panel — Environment Variables
# ================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ================================================

# Server
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=change-this-to-a-very-long-random-string-at-least-64-chars
JWT_EXPIRES_IN=7d

# Default Admin (used by seed script only)
ADMIN_EMAIL=admin@ronviana.com
ADMIN_PASSWORD=Ronviana2026!

# Database
DB_PATH=./data/ronviana.db

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=20971520

# CORS — comma-separated origins
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80

# Public URL (used for generating image URLs)
PUBLIC_URL=http://localhost:3000
